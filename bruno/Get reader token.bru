meta {
  name: Get reader token
  type: http
  seq: 1
}

post {
  url: {{zitadelUrl}}/oauth/v2/token
  body: formUrlEncoded
  auth: basic
}

headers {
  Host: zitadel.localhost:8080
}

auth:basic {
  username: {{process.env.READER_CLIENT_ID}}
  password: {{process.env.READER_CLIENT_SECRET}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: openid urn:zitadel:iam:org:project:id:{{process.env.API_PROJECT_ID}}:aud
}

script:post-response {
  bru.setVar("readerToken", res.body.access_token);
}

tests {
  test("returns an access token", () => {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}
